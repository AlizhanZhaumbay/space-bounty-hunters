              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Second attempt, target captured.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
