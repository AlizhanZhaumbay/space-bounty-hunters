                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const log = pm.response.json();",
                  "pm.collectionVariables.set(\"hunt_id\", log.id);",
                  "pm.test(\"created_at set by server\", () => pm.expect(log.created_at).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
