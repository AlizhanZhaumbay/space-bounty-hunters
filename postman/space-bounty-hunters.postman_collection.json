            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated\", () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
